# Copy this file to backend/.env and fill in local values. Never commit backend/.env.

POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5433
POSTGRES_DB=urbantwin

# SQLAlchemy URL (psycopg3). PostgreSQL 17 on the author's machine uses port 5433.
DATABASE_URL=postgresql+psycopg://postgres:change-me@127.0.0.1:5433/urbantwin

CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Shared token for the government dashboard (sent as X-Staff-Token).
# Leave empty ONLY on a private lab laptop: an empty value turns the staff login off.
STAFF_TOKEN=choose-a-long-random-string

# Where uploaded photos are stored (relative to backend/ or absolute).
UPLOAD_DIR=uploads

# Optional database for tests. Default is "<your database name>_test", created automatically.
# TEST_DATABASE_URL=postgresql+psycopg://postgres:change-me@127.0.0.1:5433/urbantwin_test

# Image-similarity model for the Investigator (downloads ~90 MB on first use, needs requirements-ai.txt).
# Set to "none" to always use the simple average hash.
EMBEDDING_MODEL=facebook/dinov2-small

# Optional "AI second opinion" on report photos (staff clicks a button; the photo leaves your machine).
# Leave blank to disable. Never commit real keys.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash
# Optional LOCAL model through Ollama (free, the photo stays on this machine). Install Ollama, run `ollama pull <a vision model>`, then set both:
# OLLAMA_URL=http://localhost:11434
# OLLAMA_MODEL=<the model you pulled>
# Hugging Face vision model (free credits are limited). The token must be allowed to call Inference Providers.
HF_API_TOKEN=
# HF_MODEL=Qwen/Qwen2.5-VL-3B-Instruct
