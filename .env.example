# Copy this file to backend/.env and fill in local values.
# Never commit backend/.env.

POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5433
POSTGRES_DB=urbantwin

# SQLAlchemy URL (psycopg3). PostgreSQL 17 on this machine uses port 5433.
DATABASE_URL=postgresql+psycopg://postgres:change-me@127.0.0.1:5433/urbantwin

CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
